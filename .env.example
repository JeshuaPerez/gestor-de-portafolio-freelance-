# =====================================================================
#  Freelance Portfolio CLI - Variables de entorno
#  Copia este archivo como `.env` y completa los valores reales.
#  El archivo `.env` está ignorado por git (ver .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# CONEXIÓN A MONGODB
# ---------------------------------------------------------------------
# IMPORTANTE: las transacciones de MongoDB SOLO funcionan sobre un
# replica set o un cluster sharded. Un mongod "standalone" las rechaza.
#
# Opción A (recomendada) - MongoDB Atlas (ya es replica set):
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=FreelanceCLI
#
# Opción B - Mongo local convertido a replica set de un nodo:
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true

# Nombre de la base de datos que usará la aplicación
MONGODB_DB=freelance_portfolio

# Base de datos que usa la versión reescrita de v2/.
# Va aparte para que las dos versiones no compartan colecciones ni índices.
# Si se deja sin definir, v2/ cae en MONGODB_DB.
MONGODB_DB_V2=freelance_portfolio_v2

# Timeout (ms) para seleccionar servidor antes de fallar la conexión
MONGODB_TIMEOUT_MS=10000

# ---------------------------------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# ---------------------------------------------------------------------
# Moneda por defecto para propuestas, contratos y movimientos.
# Código ISO 4217: GTQ = quetzal guatemalteco, COP = peso colombiano...
APP_CURRENCY=GTQ

# Código de idioma y país para formatear números y dinero.
# Decide si los miles se separan con coma o con punto, así que cambiarlo
# cambia cómo se ve TODO el dinero de la aplicación.
APP_LOCALE=es-GT

# Nombre del freelance/estudio que aparece en cabeceras y contratos
APP_OWNER=Freelance Studio

# Modo debug: true muestra el stack trace completo de los errores
APP_DEBUG=false
